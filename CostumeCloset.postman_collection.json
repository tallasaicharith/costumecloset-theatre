  "item": [
    {
      "name": "1. Twist - Return flow",
      "item": [
        {
          "name": "Test 1 - Return a hire -> 200",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hires/1/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hires",
                "1",
                "return"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Return date is set\", () => pm.expect(pm.response.json().hire.return_date).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Test 2 - Return it again -> 409",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hires/1/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "hires",
                "1",
                "return"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Message is Already returned\", () => pm.expect(pm.response.json().error).to.eql(\"Already returned\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Test 3 - Actor 1 history -> 200, it is listed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actors/1/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actors",
                "1",
                "history"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().returned_hires.map(h => h.hire_id);",
                  "pm.test(\"Hire 1 is listed\", () => pm.expect(ids).to.include(1));",
                  "pm.test(\"Only returned hires are listed\", () => pm.response.json().returned_hires.forEach(h => pm.expect(h.return_date).to.not.eql(null)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Return a hire that does not exist -> 404",
